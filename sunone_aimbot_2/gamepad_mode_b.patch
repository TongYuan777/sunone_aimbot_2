+std::vector<std::string> GamepadViGEm::getCurrentlyPressedButtons() const
+{
+    std::lock_guard<std::mutex> lock(stateMutex_);
+    std::vector<std::string> result;
+    collectPressedButtonsLocked(result);
+    return result;
+}
